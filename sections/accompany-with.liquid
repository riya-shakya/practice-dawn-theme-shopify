<style>
  .accompany-with-section{
    --bg-clr: {{section.settings.color_scheme.settings.background}};
    --text-clr: {{ section.settings.color_scheme.settings.text }};
  }
</style>

{{ 'component-accompany-with.css' | asset_url | stylesheet_tag }}

<div class="accompany-text">
  <h2>Accompany with</h2>
  {{ section.settings.accompany_text }}
</div>

{% if product.metafields.custom.accompany_with_images.value.size > 0 %}
<div class="img-section">
  {% for img in product.metafields.custom.accompany_with_images.value %}
    {{ img | image_url: width: 1200 | image_tag: class: 'accompany-img' }}
  {% endfor %}
</div>
{% endif %}

{% schema %}
{
  "name": "Accompany with",
  "class": "accompany-with-section",
  "settings": [
    {
      "type": "richtext",
      "label": "Accompany with",
      "id": "accompany_text"
    },
    {
      "type": "color_scheme",
      "label": "Color Scheme",
      "id": "color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Accompany with"
    }
  ]
}
{% endschema %}
