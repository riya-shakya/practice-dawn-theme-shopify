<style>
  .custom-footer{
    --bg-clr: {{ section.settings.footer_color_scheme.settings.background }};
    --text-clr: {{ section.settings.footer_color_scheme.settings.text }};
  }
</style>

{{ 'footer-new.css' | asset_url | stylesheet_tag }}

<div class="subscribe">
  <h3>Subscribe to our Communications</h3>
  {% form 'customer' %}
    <input type="email" name="contact[email]" placeholder="Email address" />
    <button type="submit" aria-label="Subscribe">{{ 'icon-arrow.svg' | inline_asset_content }}</button>

    {% if form.posted_successfully? %}
      <p>Subscribed Successfully</p>
    {% endif %}
  {% endform %}
</div>

<div class="navigation">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'navigation' %}
        <div {{ block.shopify_attributes }} class="nav-block">
          {% if block.settings.nav_heading != blank %}
            <h3>{{ block.settings.nav_heading }}</h3>
          {% endif %}
          {% if block.settings.nav_link_list != blank %}
            <nav>
              <ul>
                {% for link in block.settings.nav_link_list.links %}
                  <li>
                    <a href="{{link.url}}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      {% else %}

    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Footer",
  "class": "custom-footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "footer_color_scheme",
      "label": "Color Scheme"
    }
  ],
  "blocks": [
    {
      "name": "Navigation",
      "type": "navigation",
      "settings": [
        {
          "type": "text",
          "id": "nav_heading",
          "label": "Navigation Heading"
        },
        {
          "type": "link_list",
          "id": "nav_link_list",
          "label": "Navigation Links"
        }
      ],
      "limit": 3
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "navigation",
          "settings": {
            "nav_heading": "Customer Service",
            "nav_link_list": "customer-service"
          }
        },
        {
          "type": "navigation",
          "settings": {
            "nav_heading": "Company",
            "nav_link_list": "company"
          }
        }
      ]
    }
  ]
}
{% endschema %}
