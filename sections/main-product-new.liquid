{% liquid
  for block in section.blocks
    if block.type == 'metafields'
      assign card_bg_clr = block.settings.card_bg_clr
      break
    endif
  endfor
%}

<style>
  .custom-product{
    --bg-clr: {{section.settings.color_scheme.settings.background}};
    --text-clr: {{section.settings.color_scheme.settings.text}};
    --button-bg-clr: {{section.settings.color_scheme.settings.button}};
    --button-text-clr: {{section.settings.color_scheme.settings.button_label}};
    --button-shadow-clr: {{section.settings.color_scheme.settings.shadow}};
    --metafield-card-bg-clr: {{card_bg_clr}};
  }
</style>

{{ 'component-main-product-new.css' | asset_url | stylesheet_tag }}
<script src="{{'custom-variant-selector.js' |  asset_url}}" defer></script>
<script src="{{'main-product-new.js'|  asset_url}}" defer></script>

<h2 class="product__vendor">{{ product.vendor }}</h2>
<div class="product__title-and-image">
  {{
    product.featured_image
    | image_url: width: 1200
    | image_tag:
      class: 'product__image',
      widths: '400, 800, 1200',
      sizes: '(min-width: 768px) calc((100vw - 60px) * 0.3), calc(100vw - 4rem)',
      loading: 'eager',
      fetchpriority: 'high'
  }}

  {% if product.variants.size > 1 %}
    <custom-variant-selector data-section-id="{{section.id}}" class="product__variants">
      <fieldset>
        {% for variant in product.variants %}
          <div>
            <input
              type="radio"
              name="product-variant"
              value="{{variant.url}} "
              id="{{variant.title}}"
              {% if product.selected_or_first_available_variant.id == variant.id %}
                checked
              {% endif %}
            />
            <label for="{{variant.title}}">{{ variant.title }}</label>
          </div>
        {% endfor %}
      </fieldset>
    </custom-variant-selector>
  {% endif %}
</div>
{% if section.blocks.size > 0 %}
  <div class="product__information">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'title' %}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
        {% when 'description' %}
          <div class="product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
        {% when 'metafields' %}
          <div class="product__metafields" {{ block.shopify_attributes }}>
            <div class="metafield">
              <h3>Suited to</h3>
              <p>{{ product.metafields.custom.suited_to }}</p>
            </div>
            <div class="metafield">
              <h3>Skin feel</h3>
              <p>{{ product.metafields.custom.skin_feel }}</p>
            </div>
            {% if product.metafields.custom.key_ingredients.value.count > 0 %}
              <details class="metafield metafield__key-ingredient">
                <summary>
                  <div class="metafield__main-info">
                    <h3>Key ingredients</h3>
                    <div class="disclosure-svg svg--open">{{ 'icon-plus.svg' | inline_asset_content }}</div>
                    <div class="disclosure-svg svg--close">{{ 'icon-minus.svg' | inline_asset_content }}</div>
                  </div>
                  <p class="key-ingredient__name">
                    {% for item in product.metafields.custom.key_ingredients.value %}
                      <span>
                        {{- item.name -}}
                        {%- unless forloop.last %},{% endunless -%}
                      </span>
                    {% endfor %}
                  </p>
                </summary>
                <div class="metafield__img-cards-container">
                  {% for item in product.metafields.custom.key_ingredients.value %}
                    <div class="metafield__img-card">
                      {{ item.image | image_url: width: 100 | image_tag: class: 'metafield__img' }}
                      <p>{{ item.name }}</p>
                    </div>
                  {% endfor %}
                </div>
              </details>
            {% endif %}
          </div>
        {% when 'button' %}
          <add-to-cart class="add-to-cart-section" {{ block.shopify_attributes }}>
            {% form 'product', product %}
              <input type="hidden" name="product-id" value="{{ product.id }}">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <div class="add-to-cart__quantity">
                <input type="button" class="quantity--minus" value="-" aria-label="Reduce Quantity">
                <input type="number" name="quantity" min="1" value="1" class="quantity__number">
                <input type="button" class="quantity--plus" value="+" aria-label="Add Quantity">
              </div>

              {% if product.selected_or_first_available_variant.available %}
                <button type="submit" class="add-to-cart__button">
                  Add to Cart - {{ product.selected_or_first_available_variant.price | money }}
                </button>
              {% else %}
                <button type="submit" class="add-to-cart__button add-to-cart__button--disabled" disabled="true">
                  Out of Stock
                </button>
              {% endif %}
            {% endform %}
          </add-to-cart>
      {% endcase %}
    {% endfor %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Main Product",
  "class": "custom-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "name": "Product Title",
      "type": "title",
      "settings": [],
      "limit": 1
    },
    {
      "name": "Product Description",
      "type": "description",
      "settings": [],
      "limit": 1
    },
    {
      "name": "Metafields",
      "type": "metafields",
      "settings": [
        {
          "type": "color",
          "id": "card_bg_clr",
          "label": "Key ingredients card color",
          "default": "#F6F3E7"
        }
      ],
      "limit": 1
    },
    {
      "name": "Add to Cart Button",
      "type": "button",
      "settings": [],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Main Product",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "description"
        }
      ]
    }
  ]
}
{% endschema %}
