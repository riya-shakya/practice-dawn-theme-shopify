{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'daily-essentials.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --daily-essentials-space: 0.8rem;
    --daily-essentials-heading-size: clamp(2.4rem, 3vw, 4.8rem);
    --daily-essentials-heading-font: Georgia, 'Times New Roman', serif;
    --daily-essentials-card-size: 44%;
    --daily-essentials-desktop-columns: 4;
    --daily-essentials-body-size: 1.4rem;
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <slider-component class="daily-essentials__content page-width">
    <div class="daily-essentials__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="daily-essentials__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="DailyEssentialsHeading-{{ section.id }}" class="daily-essentials__heading">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}
      </div>
      <div class="daily-essentials__controls">
        {%- if section.settings.collection != blank -%}
          <a
            class="daily-essentials__collection-link"
            href="{{ section.settings.collection.url }}"
            aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title | escape }}"
          >
            {{- 'sections.featured_collection.view_all' | t -}}
          </a>
        {%- endif -%}
        {%- if section.settings.collection.products_count > 1 and section.settings.products_to_show > 1 -%}
          <button
            class="daily-essentials__button"
            type="button"
            name="previous"
            aria-controls="Slider-{{ section.id }}"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            disabled
          >
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </button>
          <button
            class="daily-essentials__button"
            type="button"
            name="next"
            aria-controls="Slider-{{ section.id }}"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            disabled
          >
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </button>
        {%- endif -%}
      </div>
    </div>
    <ul
      class="daily-essentials__products"
      id="Slider-{{ section.id }}"
      role="list"
      {% if section.settings.heading != blank %}
        aria-labelledby="DailyEssentialsHeading-{{ section.id }}"
      {% else %}
        aria-label="{{ 'templates.search.products' | t | escape }}"
      {% endif %}
      tabindex="0"
    >
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <li class="daily-essentials__item" id="Slide-{{ section.id }}-{{ product.id }}">
          <a class="daily-essentials__card" href="{{ product.url }}">
            {%- if product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 768
                | image_tag:
                  class: 'daily-essentials__image',
                  widths: '384, 768',
                  sizes: '(min-width: 750px) 25vw, 44vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'daily-essentials__image' }}
            {%- endif -%}
            <h3 class="daily-essentials__title">
              {{- product.title | escape -}}
            </h3>
            {% render 'price', product: product %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </slider-component>
</div>

{% schema %}
{
  "name": "Daily essentials",
  "class": "daily-essentials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The daily essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good habits begin here."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Daily essentials"
    }
  ]
}
{% endschema %}
