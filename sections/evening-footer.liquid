{{ 'evening-footer.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --evening-footer-text: {{ section.settings.color_scheme.settings.text }};
    --evening-footer-background: {{ section.settings.color_scheme.settings.background }};
    --evening-footer-space: max(var(--grid-desktop-horizontal-spacing), 1rem);
  }
</style>

<div class="evening-footer__content page-width">
  <div class="evening-footer__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="evening-footer__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a class="evening-footer__link" href="{{ section.settings.link | escape }}">
        {{- section.settings.link_label | escape }}
        <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </a>
    {%- endif -%}
  </div>
  <div class="evening-footer__bottom">
    <a class="evening-footer__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag: widths: '160, 320', sizes: '160px', alt: shop.name, loading: 'lazy'
        }}
      {%- else -%}
        {{- shop.name | escape -}}
      {%- endif -%}
    </a>
    <div class="evening-footer__metadata">
      <nav aria-label="{{ section.settings.menu.title | default: shop.name | escape }}">
        <ul class="evening-footer__links" role="list">
          {%- if section.settings.contact_link != blank and section.settings.contact_label != blank -%}
            <li>
              <a class="evening-footer__link" href="{{ section.settings.contact_link | escape }}">
                {{- section.settings.contact_label | escape -}}
              </a>
            </li>
          {%- endif -%}
          {%- for link in section.settings.menu.links -%}
            <li>
              <a class="evening-footer__link" href="{{ link.url | escape }}">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
          <li>
            <a class="evening-footer__link evening-footer__back-to-top" href="#top">
              Back to top
              <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            </a>
          </li>
        </ul>
      </nav>
      {%- if section.settings.credit != blank -%}
        <p class="evening-footer__credit">{{ section.settings.credit | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Evening footer",
  "tag": "footer",
  "class": "evening-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your evening,\nconsidered."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Main link label",
      "default": "Explore the skincare collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Main link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Additional menu"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Campaign credit",
      "default": "Portfolio campaign concept"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ]
}
{% endschema %}
