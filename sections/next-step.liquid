{{ 'next-step.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign card_image_sizes = '(min-width: 750px) calc((min(100vw, 1920px) - 10rem) * 0.6), calc(100vw - 3rem)'
  if section.blocks.size == 2
    assign card_image_sizes = '(min-width: 750px) calc((min(100vw, 1920px) - 10rem) * 0.3 - 2rem), calc(100vw - 3rem)'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --next-step-background: {{ section.settings.color_scheme.settings.background }};
    --next-step-text: {{ section.settings.color_scheme.settings.text }};
    --next-step-space: max(var(--grid-desktop-horizontal-spacing), 1rem);
  }
</style>

<div class="next-step__layout{% if section.blocks.size > 0 %} next-step__layout--with-cards{% endif %}">
  <div class="next-step__intro">
    {%- if section.settings.label != blank -%}
      <div class="next-step__label">
        <p>{{ section.settings.label | escape }}</p>
        <hr>
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="next-step__cards">
      {%- for block in section.blocks -%}
        <div class="next-step__card" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            <p class="next-step__label">{{ block.settings.label | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="next-step__text">{{ block.settings.text | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 768
              | image_tag:
                class: 'next-step__image',
                widths: '384, 768',
                sizes: card_image_sizes,
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'next-step__image' }}
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.button_label != blank -%}
            <a
              class="next-step__button"
              href="{{ block.settings.link | escape }}"
            >
              {{- block.settings.button_label | escape -}}
              <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Next step",
  "class": "next-step",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "YOUR NEXT STEP" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "One essential.\nOr a whole ritual."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "BEGIN SIMPLY" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the cleanser." },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "A gentle, effective cleanse to end the day, and set the tone for what comes next."
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Next step",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "label": "BUILD YOUR RITUAL",
            "heading": "Explore skin care.",
            "text": "A complete collection for your evening ritual, with considered formulations and sensorial textures.",
            "button_label": "Shop the collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
