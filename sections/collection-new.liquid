<style>
  .custom-collection{
    --bg-clr: {{ section.settings.color_scheme.settings.background }};
    --text-clr: {{ section.settings.color_scheme.settings.text }}
  }
</style>

{{ 'component-collection-new.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'custom-collection.js' |  asset_url }}" defer></script>

<custom-collection data-section-id="{{section.id}}">
  <div class="collection-content">
    <h1>{{ section.settings.heading }}</h1>

    <fieldset class="filters-container">
      {% for filter in collection.filters %}
        <input
          type="radio"
          name="filters"
          value="{{filter.url_to_remove}}"
          id="{{filter.label}}"
          data-href="{{ filter.url_to_remove }}"
          {% if filter.active_values.size == 0 %}
            checked
          {% endif %}
        />
        <label for="{{filter.label}}"> All Products </label>

        {% for filter_value in filter.values %}
          {% assign single_filter_url = collection.url
            | append: '?'
            | append: filter_value.param_name
            | append: '='
            | append: filter_value.value
          %}
          <input
            type="radio"
            name="filters"
            value="{{single_filter_url}}"
            id="{{filter_value.label}}"
            data-href="{{single_filter_url}}"
            {% if filter_value.active %}
              checked
            {% endif %}
          />
          <label for="{{filter_value.label}}">{{ filter_value.label }}</label>
        {% endfor %}
      {% endfor %}
    </fieldset>

    <div class="collection-info">
      <h1>{{ shop.name }}</h1>
      <p>{{ collection.description }}</p>
      <h1>{{ collection.title }}</h1>
    </div>
  </div>

  <div class="collection__product-grid">
    {% paginate collection.products by 12 %}
      <div class="products">
        {% for product in collection.products %}
          {% liquid
            assign image_loading = 'lazy'
            assign image_priority = 'auto'
            if forloop.first
              assign image_loading = 'eager'
              assign image_priority = 'high'
            endif
          %}
          <a href="{{product.url}}">
            <figure class="collection__product">
              <div class="product__img-container">
                {{
                  product.featured_image
                  | image_url: width: 200
                  | image_tag: loading: image_loading, fetchpriority: image_priority
                }}
              </div>
              <figcaption>
                <p>{{ product.title }}</p>
                <p>{{ product.price | money }}</p>
              </figcaption>
            </figure>
          </a>
        {% endfor %}
      </div>
      {% render 'custom-pagination', paginate: paginate, color_scheme: section.settings.color_scheme %}
    {% endpaginate %}
  </div>
</custom-collection>

{% schema %}
{
  "name": "Collection",
  "class": "custom-collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<i>Browse</i> our <i>product</i> offering"
    }
  ]
}
{% endschema %}
